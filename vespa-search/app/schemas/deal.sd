schema deal {
  document deal {
    field deal_id      type string  { indexing: attribute | summary }
    field document     type string  {
      indexing: index | summary
      # optional:
      # stemming: best
      # language: en
    }
    field category_id  type string  { indexing: attribute | summary }
    field price        type double  { indexing: attribute | summary }
    field is_active    type bool    { indexing: attribute }
    field geo          type position{ indexing: attribute | summary }

    # Vector for ANN (MiniLM → cosine/Angular)
    field embedding type tensor<float>(d0[384]) {
      indexing: attribute | index
      attribute { distance-metric: angular }
      index { hnsw { max-links-per-node: 16  neighbors-to-explore-at-insert: 200 } }
    }
  }

  fieldset default { fields: document }

  # Text-only ranking
  rank-profile text {
    first-phase { expression: bm25(document) }
  }

  # Vector-only ranking (requires nearestNeighbor(...) in WHERE)
  rank-profile vector {
    inputs { query(qemb) tensor<float>(d0[384]) }
    first-phase { expression: closeness(embedding) }
  }

  # Hybrid blend
  rank-profile hybrid {
    inputs { query(qemb) tensor<float>(d0[384]) }
    function bm_raw()  { expression: bm25(document) }
    function bm_norm() { expression: bm_raw() / (1 + bm_raw()) }
    first-phase { expression: 0.5 * bm_norm() + 0.5 * closeness(embedding) }
  }

  # Keep "default" as text
  rank-profile default inherits text { }
}